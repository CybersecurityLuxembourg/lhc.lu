{
    "parser": "@babel/eslint-parser",
    "settings": {
        "react": {
            "version": "detect"
        }
    },
    "env": {
        "browser": true,
        "es2021": true
    },
    "extends": [
    ],
    "parserOptions": {
        "sourceType": "module",
        "babelOptions": {
            "presets": [
                "@babel/preset-react"
            ]
        }
    },
    "rules": {},
    "overrides": [
        {
            "files": ["**/*.jsx", "**/*.tsx"],
            "rules": {
                "class-methods-use-this": "off"
            }
        }
    ]
}